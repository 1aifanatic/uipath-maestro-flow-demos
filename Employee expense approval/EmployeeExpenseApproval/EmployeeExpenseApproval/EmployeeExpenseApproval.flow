            "id": "branches",
            "title": "Branches",
            "collapsible": true,
            "defaultExpanded": false,
            "fields": [
              {
                "name": "inputs.branches",
                "type": "custom",
                "component": "http-branch-editor",
                "label": "Response branches",
                "description": "Define conditional branches based on response status or properties",
                "componentProps": {
                  "expressionValidationFields": [
