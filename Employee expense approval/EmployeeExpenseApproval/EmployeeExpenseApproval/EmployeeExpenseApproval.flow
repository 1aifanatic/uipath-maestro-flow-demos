{
  "id": "f44e3dc2-be3b-4c7f-aab8-31dd3ec02bbb",
  "version": "1.9",
  "name": "EmployeeExpenseApproval",
  "nodes": [
    {
      "id": "validateInput1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate Input"
      },
      "inputs": {
        "script": "const input = $vars.start.output || {};\nconst errors = [];\nif (typeof input.amount !== \"number\" || isNaN(input.amount) || input.amount < 0) {\n  errors.push(\"amount is missing or not a valid non-negative number\");\n}\nif (typeof input.employeeId !== \"string\" || input.employeeId.trim() === \"\") {\n  errors.push(\"employeeId is missing or empty\");\n}\nif (typeof input.category !== \"string\" || input.category.trim() === \"\") {\n  errors.push(\"category is missing or empty\");\n}\nif (typeof input.receiptUrl !== \"string\" || input.receiptUrl.trim() === \"\") {\n  errors.push(\"receiptUrl is missing or empty\");\n}\nreturn { isValid: errors.length === 0, errors: errors };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkInputValid1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Check Input Valid"
      },
      "inputs": {
        "expression": "$vars.validateInput1.output.isValid === true"
      }
    },
    {
      "id": "rejectInvalidInput1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Reject Invalid Input"
      },
      "inputs": {
        "script": "return { status: \"Rejected\", reason: \"Invalid submission: \" + $vars.validateInput1.output.errors.join(\"; \") };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkAutoApproval1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Check Auto Approval Threshold"
      },
      "inputs": {
        "expression": "$vars.start.output.amount <= 100"
      }
    },
    {
      "id": "autoApprove1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Auto Approve"
      },
      "inputs": {
        "script": "return { status: \"Approved\", reason: \"Auto-approved: amount \" + $vars.start.output.amount + \" is at or below the $100 threshold\" };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Approval Required",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "8f3a1c2e-4b6d-4e7a-9c1f-2d5b8a7e6f30",
          "fields": [
            {
              "id": "employeeid",
              "label": "Employee ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.employeeId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "receipturl",
              "label": "Receipt URL",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.receiptUrl"
            },
            {
              "id": "reason",
              "label": "Reason (required if rejecting)",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "reason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "buildManagerDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Build Manager Decision"
      },
      "inputs": {
        "script": "const approved = $vars.managerApproval1.status === \"Approve\";\nconst rawReason = $vars.managerApproval1.output.reason;\nconst reason = approved ? (rawReason || \"Approved by manager\") : (rawReason || \"Rejected by manager (no reason provided)\");\nreturn { status: approved ? \"Approved\" : \"Rejected\", reason: reason };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "finalizeDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Finalize Decision"
      },
      "inputs": {
        "script": "const decision = $vars.autoApprove1.output || $vars.buildManagerDecision1.output || $vars.rejectInvalidInput1.output;\nreturn { status: decision.status, reason: decision.reason };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "finalStatus": {
          "source": "=js:$vars.finalizeDecision1.output.status"
        },
        "finalReason": {
          "source": "=js:$vars.finalizeDecision1.output.reason"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "072265e1-1f4d-4ddd-9f35-547bcf950b30",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "logDecisionToFinance1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Log Decision to Finance"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "POST",
            "url": "https://mock-finance-api.example.com/api/expense-decisions",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "instanceId": "=js:$metadata.instanceId",
              "employeeId": "=js:$vars.start.output.employeeId",
              "amount": "=js:$vars.start.output.amount",
              "category": "=js:$vars.start.output.category",
              "receiptUrl": "=js:$vars.start.output.receiptUrl",
              "status": "=js:$vars.finalizeDecision1.output.status",
              "reason": "=js:$vars.finalizeDecision1.output.reason"
            }
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        },
        "errorHandlingEnabled": true
      }
    }
  ],
  "edges": [
